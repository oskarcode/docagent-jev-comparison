{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Worker identity and runtime compatibility apply to development and production.
  "name": "docagent-jev-comparison",
  "compatibility_date": "2026-08-05",
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  // Non-secret runtime settings select the AI Gateway and official MCP endpoints.
  "vars": {
    "AI_GATEWAY_ID": "flue-techdoc",
    "JEV_MODEL": "typesafe/jev",
    "JEV_SKIP_CACHE": "true",
    "CF_DOCS_VECTORIZE_MCP_URL": "https://docs.mcp.cloudflare.com/mcp",
    "AWS_KNOWLEDGE_MCP_URL": "https://knowledge-mcp.global.api.aws"
  },
  // Workers AI supplies both native models and AI Gateway binding methods.
  "ai": {
    "binding": "AI"
  },
  // The React build is an SPA; API routes run Worker code before asset lookup.
  "assets": {
    "directory": "./dist-web",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Flue owns durable conversation storage and execution.
  "durable_objects": {
    "bindings": [
      {
        "name": "FLUE_BASELINE_RESEARCH_AGENT_AGENT",
        "class_name": "FlueBaselineResearchAgentAgent"
      },
      {
        "name": "FLUE_JEV_RESEARCH_AGENT_AGENT",
        "class_name": "FlueJevResearchAgentAgent"
      }
    ]
  },
  // Never rewrite an applied migration tag; add a new tag when introducing durable classes.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["FlueBaselineResearchAgentAgent", "FlueJevResearchAgentAgent"]
    }
  ],
  // Full logs and traces support demo troubleshooting and durable-run diagnosis.
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 0.1
    },
    "traces": {
      "enabled": false
    }
  }
}
